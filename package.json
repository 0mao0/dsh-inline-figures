{
  "name": "dsh-inline-figures",
  "version": "0.0.3",
  "description": "DeepSeek Harness (DSH) host plugin: the model draws clean vector figures inline between the paragraphs of its reply, so answers arrive as text-figure-text instead of a wall of text.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/0mao0/dsh-inline-figures#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0mao0/dsh-inline-figures.git"
  },
  "bugs": {
    "url": "https://github.com/0mao0/dsh-inline-figures/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "draw_figure",
    "inline-figures",
    "svg",
    "diagrams",
    "agent-output-readability",
    "asd-ste100"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./engine": "./lib/engine.js",
    "./guidance": "./lib/guidance.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README-zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "test": "node --test",
    "test:sandbox": "node --test --test-isolation=none",
    "readme-image": "node scripts/make-readme-image.mjs",
    "readme-diagram": "node scripts/make-readme-diagram.mjs",
    "readme-assets": "node scripts/make-readme-image.mjs && node scripts/make-readme-diagram.mjs",
    "release": "node scripts/release.mjs",
    "notes": "node scripts/release.mjs --notes"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Inline Figures",
    "description": "Render explanatory vector figures inline in model replies: the draw_figure tool turns JSON diagram specs into full-width figures that Markdown embeds between paragraphs."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
